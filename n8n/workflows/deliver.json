    {
      "id": "618a3803-5703-474f-b92c-892520189eea",
      "name": "Validate SMTP recipient acceptance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        416
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const result = $input.first().json;\nconst prepared = $('Prepare safe email message').first().json;\nconst expected = prepared.destination;\nconst envelope = result?.envelope;\nconst envelopeMatches = envelope === undefined ||\n  (envelope && envelope.from === prepared.sender && Array.isArray(envelope.to) &&\n   envelope.to.length === 1 && envelope.to[0] === expected);\nconst accepted = prepared.valid === true && typeof expected === 'string' && expected.length > 0 &&\n  typeof prepared.sender === 'string' && prepared.sender.length > 0 &&\n  result && typeof result === 'object' && !Object.hasOwn(result, 'error') &&\n  Array.isArray(result.accepted) && result.accepted.length === 1 &&\n  result.accepted[0] === expected && Array.isArray(result.rejected) &&\n  result.rejected.length === 0 && envelopeMatches;\nreturn [{ json: { id: prepared.id, accepted } }];\n"
      }
    },
