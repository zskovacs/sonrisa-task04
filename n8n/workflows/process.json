    {
      "id": "a0347d8e-b5f3-464f-9407-e25dc5e9e924",
      "name": "Select trusted feed path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        768
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $input.first().json;\nif (input.mode === 'live' && input.fixture_json === '') {\n  return [{ json: { mode: 'live' } }];\n}\nif (input.mode !== 'fixture') {\n  throw new Error('invalid_ingest_mode');\n}\nif (typeof input.fixture_json !== 'string' || input.fixture_json.length === 0 || input.fixture_json.length > 2097152) throw new Error('invalid_fixture_feed');\nlet feed;\ntry {\n  feed = JSON.parse(input.fixture_json);\n} catch {\n  throw new Error('invalid_fixture_feed');\n}\nreturn [{ json: { mode: 'fixture', source: 'demo.usgs', feed } }];\n"
      }
    },
