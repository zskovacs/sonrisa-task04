    {
      "id": "fab72da2-0da5-41b4-96f9-5ce0694a90f8",
      "name": "Prepare safe Slack text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3136,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const output = [];\nconst escape = value => String(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nfor (const item of $input.all()) {\n  const { event, alert_id: alertId, channel, destination } = item.json ?? {};\n  if (channel !== 'slack' || typeof destination !== 'string' || !/^[A-Z0-9]{2,80}$/.test(destination) || typeof event?.external_id !== 'string' || !/^[!-~]{1,128}$/.test(event.external_id) || typeof event?.title !== 'string' || typeof event?.data?.magnitude !== 'number' || !Number.isFinite(event.data.magnitude)) {\n    throw new Error('invalid_slack_notification');\n  }\n  const synthetic = event.source === 'demo.usgs' ? '[SYNTHETIC] ' : '';\n  const text = `${synthetic}Earthquake M ${event.data.magnitude}: ${escape(event.title)}\\nOccurred: ${escape(event.occurred_at)}\\nSource: ${escape(event.source)}\\nEvent: ${escape(event.external_id)}\\nAlert: ${escape(alertId)}`;\n  output.push({ json: { destination, text } });\n}\nreturn output;\n"
      },
      "onError": "continueErrorOutput"
    },
