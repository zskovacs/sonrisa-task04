@page "/admin/users"
@model Sonrisa.Web.Pages.Admin.UsersModel
@{ ViewData["Title"] = "Admin owners"; }
<h1 class="text-2xl font-bold">Owners</h1>
<p class="mt-1 text-slate-700">Owner configuration across the product. Destination values are hidden.</p>
<partial name="_AdminNav" />
@if (Model.Unavailable)
{
    <p class="mt-6 rounded border border-amber-300 bg-amber-50 p-4 text-amber-900" role="alert">Admin configuration is temporarily unavailable. Please try again later.</p>
}
else if (Model.Owners.Count == 0)
{
    <section class="mt-6 rounded border border-dashed border-slate-300 bg-white p-6"><h2 class="text-lg font-semibold">No owners yet</h2><p class="mt-2 text-slate-700">Owners appear here after notification settings are saved.</p></section>
}
else
{
    <div class="mt-6 overflow-x-auto rounded border border-slate-200 bg-white">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-100 text-left text-sm text-slate-700"><tr><th scope="col" class="px-4 py-3">Owner UUID</th><th scope="col" class="px-4 py-3">Alerts</th><th scope="col" class="px-4 py-3">Enabled</th><th scope="col" class="px-4 py-3">Slack</th><th scope="col" class="px-4 py-3">Email</th></tr></thead>
            <tbody class="divide-y divide-slate-200">
            @foreach (var owner in Model.Owners)
            {
                <tr><td class="px-4 py-3 font-mono text-sm">@owner.Id</td><td class="px-4 py-3">@owner.AlertCount</td><td class="px-4 py-3">@owner.EnabledCount</td><td class="px-4 py-3">@(owner.HasSlack ? "Yes" : "No")</td><td class="px-4 py-3">@(owner.HasEmail ? "Yes" : "No")</td></tr>
            }
            </tbody>
        </table>
    </div>
}
