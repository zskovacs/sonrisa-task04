@page "/admin/alerts"
@model Sonrisa.Web.Pages.Admin.AlertsModel
@{ ViewData["Title"] = "Admin alerts"; }
<h1 class="text-2xl font-bold">All alerts</h1>
<p class="mt-1 text-slate-700">Alert configuration across all owners. Delivery history and retry details are available in n8n.</p>
<partial name="_AdminNav" />
@if (Model.Unavailable)
{
    <p class="mt-6 rounded border border-amber-300 bg-amber-50 p-4 text-amber-900" role="alert">Admin configuration is temporarily unavailable. Please try again later.</p>
}
else if (Model.Alerts.Count == 0)
{
    <section class="mt-6 rounded border border-dashed border-slate-300 bg-white p-6"><h2 class="text-lg font-semibold">No alerts yet</h2><p class="mt-2 text-slate-700">Alerts appear here after an owner creates one.</p></section>
}
else
{
    <div class="mt-6 overflow-x-auto rounded border border-slate-200 bg-white">
        <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-100 text-left text-sm text-slate-700"><tr><th scope="col" class="px-4 py-3">Owner UUID</th><th scope="col" class="px-4 py-3">Name</th><th scope="col" class="px-4 py-3">Event type</th><th scope="col" class="px-4 py-3">Status</th><th scope="col" class="px-4 py-3">Condition</th><th scope="col" class="px-4 py-3">Channels</th></tr></thead>
            <tbody class="divide-y divide-slate-200">
            @foreach (var alert in Model.Alerts)
            {
                <tr><td class="px-4 py-3 font-mono text-sm">@alert.OwnerId</td><td class="px-4 py-3 font-medium">@alert.Name</td><td class="px-4 py-3">@alert.EventType</td><td class="px-4 py-3">@(alert.Enabled ? "Enabled" : "Disabled")</td><td class="px-4 py-3">@alert.Condition</td><td class="px-4 py-3">@alert.Channels</td></tr>
            }
            </tbody>
        </table>
    </div>
}
